<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="Soul Track"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_session_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Ready to start"
        android:textColor="#B0FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_session_name"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Tap to select category"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:background="@drawable/widget_button_background"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp" />

    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_category"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="00:00:00"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_timer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text=""
        android:textColor="#B0FFFFFF"
        android:textSize="11sp"
        android:fontFamily="serif"
        android:fontStyle="italic"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.1"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_quote_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_quote"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#80FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/widget_btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_stop_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="RESET"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</RelativeLayout>
